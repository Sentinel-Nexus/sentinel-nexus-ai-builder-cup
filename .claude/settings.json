{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git push -u origin:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(python:*)",
      "Bash(pip install:*)",
      "Bash(bq ls:*)",
      "Bash(bq show:*)",
      "Bash(bq head:*)",
      "Bash(python infra/deploy_app.py:*)",
      "Bash(gcloud run services describe sentinel-app:*)",
      "Bash(gcloud run revisions list --service sentinel-app:*)",
      "Bash(gcloud run services logs read sentinel-app:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*credentials*.json)",
      "Read(**/*service-account*.json)",
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git reset --hard:*)",
      "Bash(git branch -D:*)",
      "Bash(bq rm:*)",
      "Bash(gcloud *delete*)",
      "Bash(bq *delete*)"
    ]
  }
}
